# terraform.tfvars로 복사해서 사용합니다. terraform.tfvars는 커밋하지 않습니다. 계정 ID·비밀값은 넣지 않습니다.
domain_name = "stockdrop.cloud"

# 이미 있는 Route 53 공개 Zone을 쓰려면 ID를 넣습니다. 비워 두면 새로 만듭니다.
hosted_zone_id = ""

# 1차 적용 후 output public_name_servers를 도메인 등록업체에 넣고, 네임서버가 바뀐 뒤 true로 바꿔 다시 적용합니다.
enable_https = false

# 이미지 버킷 CORS 허용 주소입니다. 프론트 주소가 바뀌면 함께 바꿉니다.
browser_origins = ["https://stockdrop-app.vercel.app", "http://localhost:5173"]

# CloudWatch 알람 메일입니다. 적용 후 각 주소로 온 확인 메일을 승인해야 받습니다.
alert_emails = []

# 서버 수 범위입니다. 평소 대수(min)와 증설 상한(max)입니다.
general_min_size  = 2
general_max_size  = 3
purchase_min_size = 2
purchase_max_size = 4

# Command DB 사양은 설계도에 정해져 있지 않아 변수로 받습니다. k6 결과를 보고 정합니다.
host_instance_types = {
  command-db = "t4g.small"
  kafka      = "t4g.small"
  monitoring = "t4g.small"
}
